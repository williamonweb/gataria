# Banco Neon usado pelo CMS quando o site estiver publicado.
DATABASE_URL=

# Usuário e senha de acesso ao painel /admin.
# Em desenvolvimento local, os padrões são: admin / gataria-admin
CMS_USERNAME=
CMS_PASSWORD=

# Texto longo e aleatório usado para assinar a sessão do painel.
CMS_SECRET=

# Reservado para a segunda etapa: checkout Mercado Pago.
ENABLE_CHECKOUT=false
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
